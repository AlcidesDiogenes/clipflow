                    <!-- PAINÉIS DE CONFIGURAÇÃO COM SCROLL SUAVE -->
                    <ScrollViewer Grid.Column="1"
                                  VerticalScrollBarVisibility="Auto"
                                  CanContentScroll="False"
                                  platform:SmoothScrollBehavior.IsEnabled="True"
                                  Padding="22,18">
                        <Grid>
                            <!-- ==================== SEÇÃO 1: GERAL & SISTEMA ==================== -->
                            <StackPanel x:Name="PanelGeneral" Visibility="Visible">
                                <Grid Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Geral e Integração com o Sistema"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="16.5"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="Comportamento de inicialização, foco e visualização do pop-up do ClipFlow."
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="11.5"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource SettingCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Iniciar junto com o Windows" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="Inicia o ClipFlow automaticamente no login para você sempre ter o histórico pronto." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <CheckBox x:Name="ChkStartWithWindows" Grid.Column="1" Style="{StaticResource ToggleCheckStyle}" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Iniciar silenciosamente na Bandeja (System Tray)" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="O aplicativo inicia diretamente no relógio do sistema, sem abrir nenhuma janela na tela." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <CheckBox x:Name="ChkStartMinimized" Grid.Column="1" Style="{StaticResource ToggleCheckStyle}" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Ocultar ao clicar fora da janela" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="Fecha o pop-up automaticamente ao clicar em outro programa (comportamento nativo do Win+V)." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <CheckBox x:Name="ChkCloseOnBlur" Grid.Column="1" Style="{StaticResource ToggleCheckStyle}" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Manter janela sempre visível no topo (Always on Top)" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="Garante que a lista do histórico fique sempre acima de outros navegadores e aplicativos." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <CheckBox x:Name="ChkAlwaysOnTop" Grid.Column="1" Style="{StaticResource ToggleCheckStyle}" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- ==================== SEÇÃO 2: ATALHOS & BORDA ==================== -->
                            <StackPanel x:Name="PanelShortcuts" Visibility="Collapsed">
                                <Grid Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Atalhos Globais, Bordas da Tela &amp; Colagem"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="16.5"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="Configure a combinação de teclas de abertura, gatilhos de mouse e velocidade de injeção."
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="11.5"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource SettingCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="215" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Abrir ao encostar o Mouse na Borda da Tela" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="Abre o ClipFlow instantaneamente quando você move o ponteiro até a lateral do monitor." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox x:Name="CmbEdgeTrigger"
                                                  Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  SelectionChanged="CmbEdgeTrigger_SelectionChanged">
                                            <ComboBoxItem Content="Desativado (Só Atalho)" Tag="0" />
                                            <ComboBoxItem Content="Somente Borda Esquerda" Tag="1" />
                                            <ComboBoxItem Content="Somente Borda Direita" Tag="2" />
                                            <ComboBoxItem Content="Ambas (Esquerda e Direita)" Tag="3" />
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="215" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Sensibilidade / Tempo na Borda" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="Tempo de repouso na borda antes de abrir para prevenir aberturas acidentais." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox x:Name="CmbEdgeDelay" Grid.Column="1" VerticalAlignment="Center">
                                            <ComboBoxItem Content="Instantâneo (100 ms)" Tag="100" />
                                            <ComboBoxItem Content="Rápido / Padrão (220 ms)" Tag="220" />
                                            <ComboBoxItem Content="Equilibrado (380 ms)" Tag="380" />
                                            <ComboBoxItem Content="Seguro (600 ms)" Tag="600" />
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="215" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Atalho Global de Teclado" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="Combinação do sistema para exibir ou ocultar a janela de qualquer lugar." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox x:Name="CmbShortcut" Grid.Column="1" VerticalAlignment="Center">
                                            <ComboBoxItem Content="Ctrl + Shift + V" Tag="0" />
                                            <ComboBoxItem Content="Alt + V" Tag="1" />
                                            <ComboBoxItem Content="Ctrl + Alt + V" Tag="2" />
                                            <ComboBoxItem Content="Ctrl + Shift + C" Tag="3" />
                                            <ComboBoxItem Content="Alt + C" Tag="4" />
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Colar automaticamente ao pressionar Enter / Duplo Clique" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="Injeta o conteúdo direto no aplicativo anterior (se desativado, apenas copia para a área de transferência)." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <CheckBox x:Name="ChkPasteDirectly" Grid.Column="1" Style="{StaticResource ToggleCheckStyle}" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Colar sempre como Texto Puro (Sem Formatação)" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="Remove estilos, fontes, tabelas e cores HTML automaticamente ao colar." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <CheckBox x:Name="ChkDefaultPlainText" Grid.Column="1" Style="{StaticResource ToggleCheckStyle}" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Mover item para o topo quando for colado" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="Coloca os itens usados com mais frequência sempre no início da lista." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <CheckBox x:Name="ChkMoveToTopOnPaste" Grid.Column="1" Style="{StaticResource ToggleCheckStyle}" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="215" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Velocidade de Injeção de Colagem (Delay)" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="Ajusta o tempo de foco antes de disparar o Ctrl+V (aumente se usar máquinas virtuais)." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox x:Name="CmbPasteDelay" Grid.Column="1" VerticalAlignment="Center">
                                            <ComboBoxItem Content="Ultra Rápido (15 ms)" Tag="15" />
                                            <ComboBoxItem Content="Padrão (35 ms)" Tag="35" />
                                            <ComboBoxItem Content="Compatível (65 ms)" Tag="65" />
                                            <ComboBoxItem Content="Lento / VM (120 ms)" Tag="120" />
                                        </ComboBox>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- ==================== SEÇÃO 3: HISTÓRICO & CAPTURA ==================== -->
                            <StackPanel x:Name="PanelHistory" Visibility="Collapsed">
                                <Grid Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Capacidade do Histórico &amp; Tipos de Dados"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="16.5"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="Defina a quantidade de itens salvos e os tipos de conteúdo interceptados pelo ClipFlow."
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="11.5"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource SettingCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="200" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Limite Máximo do Histórico" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="Capacidade máxima de cópias comuns. Seus itens FIXADOS nunca contam no limite e nunca são apagados." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox x:Name="CmbMaxHistory" Grid.Column="1" VerticalAlignment="Center">
                                            <ComboBoxItem Content="50 itens" Tag="50" />
                                            <ComboBoxItem Content="100 itens" Tag="100" />
                                            <ComboBoxItem Content="200 itens (Padrão)" Tag="200" />
                                            <ComboBoxItem Content="500 itens" Tag="500" />
                                            <ComboBoxItem Content="1000 itens" Tag="1000" />
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Exibir itens Fixados também na aba 'Texto'" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="Se desativado, a aba 'Texto' mostrará apenas textos normais, tornando os Fixados exclusivos da sua própria aba." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <CheckBox x:Name="ChkShowPinnedInTextTab" Grid.Column="1" Style="{StaticResource ToggleCheckStyle}" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Capturar Textos, Links, Cores e Códigos" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="Armazena textos copiados e detecta links, e-mails, números de telefone e cores Hex." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <CheckBox x:Name="ChkCaptureText" Grid.Column="1" Style="{StaticResource ToggleCheckStyle}" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Capturar Imagens e Print Screen" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="Salva prints (Win+Shift+S) e fotos copiadas na internet, gerando miniaturas rápidas." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <CheckBox x:Name="ChkCaptureImages" Grid.Column="1" Style="{StaticResource ToggleCheckStyle}" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Capturar Arquivos Copiados no Windows Explorer" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="Registra caminhos de arquivos e pastas copiados para você colar listas com facilidade." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <CheckBox x:Name="ChkCaptureFiles" Grid.Column="1" Style="{StaticResource ToggleCheckStyle}" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="200" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Tamanho Máximo por Texto Copiado" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="Ignora arquivos de texto gigantescos que excedam o limite para não pesar na memória RAM." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox x:Name="CmbMaxTextSize" Grid.Column="1" VerticalAlignment="Center">
                                            <ComboBoxItem Content="256 KB" Tag="256" />
                                            <ComboBoxItem Content="512 KB" Tag="512" />
                                            <ComboBoxItem Content="1 MB (Padrão)" Tag="1024" />
                                            <ComboBoxItem Content="2 MB" Tag="2048" />
                                        </ComboBox>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- ==================== SEÇÃO 7: TEXTOS RÁPIDOS & MODIFICADORES ==================== -->
                            <StackPanel x:Name="PanelModifiers" Visibility="Collapsed">
                                <Grid Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Textos Rápidos, Modelos &amp; Modificadores"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="16.5"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="Crie saudações ou textos automáticos (como 'Bom dia!', 'Boa tarde!') para anexar antes ou depois de colar com Alt+1 a Alt+9."
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="11.5"
                                                   Margin="0,3,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>

                                <!-- Card do Editor (Adicionar / Editar) -->
                                <Border Style="{StaticResource SettingCardStyle}" Padding="18,16" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="EDITOR" Foreground="#93C5FD" FontWeight="Bold" FontSize="10" />
                                                </Border>
                                                <TextBlock x:Name="TxtEditorTitle"
                                                           Text="Adicionar Novo Texto / Modificador"
                                                           Foreground="{DynamicResource AccentTextBrush}"
                                                           FontWeight="Bold"
                                                           FontSize="13" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Linha 1: Nome no Chip e Posição -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Nome no Chip (Rótulo Curto):"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Margin="0,0,0,5" />
                                                <TextBox x:Name="TxtModLabel"
                                                         TextChanged="ModEditorField_Changed" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Onde Inserir:"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Margin="0,0,0,5" />
                                                <ComboBox x:Name="CmbModPosition"
                                                          SelectionChanged="ModEditorField_Changed">
                                                    <ComboBoxItem Content="No Começo (Prefixo)" Tag="0" IsSelected="True" />
                                                    <ComboBoxItem Content="No Fim (Sufixo)" Tag="1" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Linha 2: Texto a Inserir -->
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="Texto a Inserir:"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Margin="0,0,0,5" />
                                            <TextBox x:Name="TxtModText"
                                                     AcceptsReturn="True"
                                                     MinHeight="36"
                                                     MaxHeight="80"
                                                     TextChanged="ModEditorField_Changed" />
                                        </StackPanel>

                                        <!-- Linha 3: Espaçamento e Auto-Reset -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Espaçamento / Quebra de Linha:"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Margin="0,0,0,5" />
                                                <ComboBox x:Name="CmbModSpacing"
                                                          SelectionChanged="ModEditorField_Changed">
                                                    <ComboBoxItem Content="Quebra dupla (novo parágrafo)" Tag="0" IsSelected="True" />
                                                    <ComboBoxItem Content="Quebra simples (nova linha)" Tag="1" />
                                                    <ComboBoxItem Content="Espaço simples" Tag="2" />
                                                    <ComboBoxItem Content="Sem espaço (direto)" Tag="3" />
                                                </ComboBox>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,18,0,0">
                                                <CheckBox x:Name="ChkModAutoReset"
                                                          Style="{StaticResource ToggleCheckStyle}"
                                                          Content="Resetar seleção após colar"
                                                          IsChecked="True"
                                                          ToolTip="Ao colar, aplica o texto e volta para 'Nenhum' automaticamente" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Pré-visualização ao vivo -->
                                        <Border Background="{DynamicResource HeaderFooterBgBrush}"
                                                BorderBrush="{DynamicResource DividerBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12,10"
                                                Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="Prévia do Texto Colado:"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,5" />
                                                <TextBlock x:Name="TxtModPreview"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           FontFamily="Consolas, Segoe UI" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Botões de Ação do Editor -->
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="BtnSaveModifier"
                                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                                    Content="Salvar Modificador"
                                                    Margin="0,0,8,0"
                                                    Click="SaveModifierItem_Click" />
                                            <Button x:Name="BtnCancelModifier"
                                                    Style="{StaticResource ActionButtonStyle}"
                                                    Content="Cancelar / Limpar"
                                                    Click="CancelModifierItem_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Lista de Modificadores Cadastrados -->
                                <TextBlock Text="Modificadores Cadastrados (Atalhos Alt+1 a Alt+9):"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Margin="0,4,0,10" />

                                <ItemsControl x:Name="ModifiersItemsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SettingCardStyle}" Padding="14,12" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding Label}" Foreground="#93C5FD" FontWeight="Bold" FontSize="11" />
                                                            </Border>
                                                            <Border Background="{DynamicResource ButtonBgBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding PositionDescription}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" FontSize="11" />
                                                            </Border>
                                                            <TextBlock Text="{Binding SpacingDescription, StringFormat='• {0}'}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <TextBlock Text="{Binding Text, StringFormat='Texto: &quot;{0}&quot;'}"
                                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                                   FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxHeight="36" />

                                                        <TextBlock Text="{Binding AutoReset, StringFormat='Auto-reset após colar: {0}'}"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   FontSize="10.5"
                                                                   Margin="0,4,0,0" />
                                                    </StackPanel>

                                                    <!-- Botões de Ação na Linha -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource ActionButtonStyle}"
                                                                Content="▲"
                                                                Padding="7,5"
                                                                Margin="0,0,4,0"
                                                                ToolTip="Mover para cima"
                                                                Tag="{Binding}"
                                                                Click="MoveUpModifier_Click" />
                                                        <Button Style="{StaticResource ActionButtonStyle}"
                                                                Content="▼"
                                                                Padding="7,5"
                                                                Margin="0,0,4,0"
                                                                ToolTip="Mover para baixo"
                                                                Tag="{Binding}"
                                                                Click="MoveDownModifier_Click" />
                                                        <Button Style="{StaticResource ActionButtonStyle}"
                                                                Content="Editar"
                                                                Padding="9,5"
                                                                Margin="0,0,4,0"
                                                                Tag="{Binding}"
                                                                Click="EditModifier_Click" />
                                                        <Button Style="{StaticResource ActionButtonStyle}"
                                                                Content="✕"
                                                                Padding="8,5"
                                                                Foreground="#EF4444"
                                                                ToolTip="Excluir modificador"
                                                                Tag="{Binding}"
                                                                Click="DeleteModifier_Click" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- ==================== SEÇÃO 4: APARÊNCIA & TEMA ==================== -->
                            <StackPanel x:Name="PanelAppearance" Visibility="Collapsed">
                                <Grid Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Tema Visual &amp; Dimensões da Janela"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="16.5"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="Ajuste o modo claro/escuro, dimensões, opacidade e ponto de abertura na tela."
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="11.5"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource SettingCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="200" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Tema Visual (Claro / Escuro)" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="Alterna instantaneamente todas as cores da interface entre o modo Escuro e o modo Claro." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox x:Name="CmbTheme"
                                                  Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  SelectionChanged="CmbTheme_SelectionChanged">
                                            <ComboBoxItem Content="🌙 Tema Escuro (Dark)" Tag="0" />
                                            <ComboBoxItem Content="☀️ Tema Claro (Light)" Tag="1" />
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="230" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Posição de Abertura da Janela" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="Escolha onde o pop-up deve brotar na tela (cursor, centro, laterais ou cantos)." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox x:Name="CmbSpawnPosition" Grid.Column="1" VerticalAlignment="Center">
                                            <ComboBoxItem Content="Próximo ao Cursor do Mouse" Tag="0" />
                                            <ComboBoxItem Content="Centralizado no Monitor" Tag="1" />
                                            <ComboBoxItem Content="Na Borda Esquerda da Tela" Tag="2" />
                                            <ComboBoxItem Content="Na Borda Direita da Tela" Tag="3" />
                                            <ComboBoxItem Content="Na Borda Mais Próxima (Esq/Dir)" Tag="4" />
                                            <ComboBoxItem Content="Canto Inferior Direito (Win+V)" Tag="5" />
                                            <ComboBoxItem Content="Canto Superior Direito" Tag="6" />
                                            <ComboBoxItem Content="Canto Superior Esquerdo" Tag="7" />
                                            <ComboBoxItem Content="Canto Inferior Esquerdo" Tag="8" />
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="230" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Abrir ao Levar o Mouse até as Bordas" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="Define em qual lateral da tela encostar o mouse faz a janela abrir." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox x:Name="CmbEdgeTriggerAppearance"
                                                  Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  SelectionChanged="CmbEdgeTriggerAppearance_SelectionChanged">
                                            <ComboBoxItem Content="Desativado (Não abrir pela borda)" Tag="0" />
                                            <ComboBoxItem Content="Somente Borda Esquerda" Tag="1" />
                                            <ComboBoxItem Content="Somente Borda Direita" Tag="2" />
                                            <ComboBoxItem Content="Ambas (Direita e Esquerda)" Tag="3" />
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="200" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Tamanho da Janela do ClipFlow" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="Escolha o tamanho mais confortável para sua resolução de monitor." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox x:Name="CmbWindowSize" Grid.Column="1" VerticalAlignment="Center">
                                            <ComboBoxItem Content="Compacta (400 × 520)" Tag="400x520" />
                                            <ComboBoxItem Content="Padrão (440 × 580)" Tag="440x580" />
                                            <ComboBoxItem Content="Ampla (520 × 680)" Tag="520x680" />
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="200" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Opacidade da Janela" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="Controla a translucidez para você poder enxergar sob a janela." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox x:Name="CmbOpacity" Grid.Column="1" VerticalAlignment="Center">
                                            <ComboBoxItem Content="100% (Sólida)" Tag="1.0" />
                                            <ComboBoxItem Content="95% (Suave)" Tag="0.95" />
                                            <ComboBoxItem Content="90% (Translúcida)" Tag="0.90" />
                                            <ComboBoxItem Content="85% (Mais Transparente)" Tag="0.85" />
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Exibir dicas de atalhos no rodapé" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="Mostra os lembretes de teclas úteis (Enter, F2, Delete) na barra inferior." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <CheckBox x:Name="ChkShowFooterHints" Grid.Column="1" Style="{StaticResource ToggleCheckStyle}" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- ==================== SEÇÃO 5: PRIVACIDADE & SENHAS ==================== -->
                            <StackPanel x:Name="PanelPrivacy" Visibility="Collapsed">
                                <Grid Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Privacidade, Filtros de Senha &amp; Segurança"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="16.5"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="Proteja dados sensíveis impedindo que credenciais e apps confidenciais sejam registrados."
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="11.5"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource SettingCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Ignorar Gerenciadores de Senha Automaticamente" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="Respeita as flags de segurança do Windows e ignora senhas copiadas do 1Password, Bitwarden, KeePass, etc." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <CheckBox x:Name="ChkIgnorePasswordManagers" Grid.Column="1" Style="{StaticResource ToggleCheckStyle}" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Bloquear captura de Chaves Privadas e Tokens de API" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="Detecta e descarta automaticamente tokens como sk-, ghp_, AKIA e blocos PRIVATE KEY." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <CheckBox x:Name="ChkIgnoreSecrets" Grid.Column="1" Style="{StaticResource ToggleCheckStyle}" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Aplicativos Bloqueados (Separados por vírgula)" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="Qualquer cópia (Ctrl+C) originada dentro dos programas desta lista será ignorada:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,3,0,8" TextWrapping="Wrap" />
                                        <TextBox x:Name="TxtExcludedApps" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ==================== SEÇÃO 6: DADOS & LIMPEZA ==================== -->
                            <StackPanel x:Name="PanelData" Visibility="Collapsed">
                                <Grid Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Armazenamento Local &amp; Gerenciamento de Dados"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="16.5"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="Acesse a pasta de arquivos locais, libere espaço no disco ou restaure padrões."
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="11.5"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource SettingCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Pasta de Armazenamento Local" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock x:Name="TxtDataFolderPath" Foreground="{DynamicResource AccentTextBrush}" FontSize="12" Margin="0,4,0,10" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource ActionButtonStyle}"
                                                    Content="Abrir Pasta no Explorer"
                                                    Click="OpenDataFolder_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Gerenciamento de Histórico" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock x:Name="TxtStorageStats" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,4,0,12" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource ActionButtonStyle}"
                                                    Content="Limpar Histórico Não-Fixado"
                                                    Margin="0,0,10,0"
                                                    Click="ClearUnpinned_Click" />
                                            <Button Style="{StaticResource DangerActionButtonStyle}"
                                                    Content="Apagar Tudo (Incluindo Fixados)"
                                                    Click="ClearAll_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Restaurar Padrões de Fábrica" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="Restaura todas as opções, bordas e limites para a configuração recomendada original." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource ActionButtonStyle}"
                                                Content="Restaurar Padrões"
                                                Click="ResetDefaults_Click" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- ==================== RODAPÉ COM SALVAR / CANCELAR ==================== -->
                <Border Grid.Row="2"
                        Background="{DynamicResource HeaderFooterBgBrush}"
                        CornerRadius="0,0,12,12"
                        BorderBrush="{DynamicResource DividerBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="20,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentTextBrush}" Margin="0,0,8,0" />
                            <TextBlock x:Name="TxtSaveFeedback"
                                       Text="Altere qualquer opção e clique em Salvar Alterações."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource ActionButtonStyle}"
                                    Content="Cancelar"
                                    Margin="0,0,10,0"
                                    Click="CloseButton_Click" />
                            <Button Style="{StaticResource PrimaryActionButtonStyle}"
                                    Content="Salvar Alterações"
                                    Click="SaveSettings_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
