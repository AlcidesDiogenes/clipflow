<Window x:Class="ClipFlow.App.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:platform="clr-namespace:ClipFlow.App.Platform"
        Title="ClipFlow"
        Width="440"
        Height="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.BitmapScalingMode="HighQuality"
        FontFamily="Segoe UI, Segoe UI Variable Text"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Estilo de Botão de Aba -->
        <Style x:Key="TabButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonBgBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2563EB" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de Botão Compacto do Topo -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBgBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de Botão de Ação nos Cards -->
        <Style x:Key="CardActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2563EB" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de Botão Chip de Modificador -->
        <Style x:Key="ModifierChipButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>
    </Window.Resources>

    <!-- Grid Raiz separando a camada de Sombra da camada de Conteúdo -->
    <Grid Margin="12">
        <!-- Camada 1: Apenas Sombra (Sem filhos dentro para não rasterizar os textos!) -->
        <Border Background="{DynamicResource WindowBgBrush}"
                CornerRadius="12"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="#000000" />
            </Border.Effect>
        </Border>

        <!-- Camada 2: Conteúdo Nítido com Renderização Vetorial Direta -->
        <Border Background="{DynamicResource WindowBgBrush}"
                BorderBrush="{DynamicResource WindowBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                UseLayoutRounding="True"
                SnapsToDevicePixels="True"
                RenderOptions.ClearTypeHint="Enabled"
                TextOptions.TextFormattingMode="Display"
                TextOptions.TextRenderingMode="ClearType"
                TextOptions.TextHintingMode="Fixed">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- 0: Cabeçalho -->
                    <RowDefinition Height="Auto" /> <!-- 1: Busca -->
                    <RowDefinition Height="Auto" /> <!-- 2: Abas -->
                    <RowDefinition Height="Auto" /> <!-- 3: Modificadores de Texto (Chips) -->
                    <RowDefinition Height="Auto" /> <!-- 4: Editor de Apelido -->
                    <RowDefinition Height="*" />    <!-- 5: Lista de Cards -->
                    <RowDefinition Height="Auto" /> <!-- 6: Rodapé -->
                </Grid.RowDefinitions>

                <!-- 1. CABEÇALHO -->
                <Border Grid.Row="0"
                        Background="{DynamicResource HeaderFooterBgBrush}"
                        CornerRadius="12,12,0,0"
                        BorderBrush="{DynamicResource DividerBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,10"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="22" Height="22" CornerRadius="6" Background="#2563EB" Margin="0,0,8,0">
                                <Path Data="M7,2 L4,9 L8,9 L6,15 L13,7 L9,7 Z"
                                      Fill="#FACC15"
                                      Stretch="Uniform"
                                      Margin="4" />
                            </Border>

                            <TextBlock Text="ClipFlow"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontWeight="Bold"
                                       FontSize="14.5"
                                       VerticalAlignment="Center" />

                            <Border Background="{DynamicResource ShortcutBadgeBgBrush}"
                                    BorderBrush="#3B82F6"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="7,2"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="ShortcutBadge_Click"
                                    ToolTip="Clique para alternar o atalho global">
                                <TextBlock Text="{Binding ShortcutBadgeText}"
                                           Foreground="{DynamicResource AccentTextBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource HeaderButtonStyle}"
                                    Content="{Binding PauseButtonLabel}"
                                    Margin="0,0,6,0"
                                    ToolTip="Pausar ou retomar captura da área de transferência"
                                    Click="PauseCapture_Click" />
                            <Button Style="{StaticResource HeaderButtonStyle}"
                                    Content="Limpar"
                                    Margin="0,0,6,0"
                                    ToolTip="Limpar histórico (mantém todos os itens Fixados)"
                                    Click="ClearHistory_Click" />
                            <!-- Botão Somente Engrenagem (Sem Texto) ao lado do Fechar -->
                            <Button Style="{StaticResource HeaderButtonStyle}"
                                    Padding="7,5"
                                    Margin="0,0,6,0"
                                    ToolTip="Abrir Configurações do ClipFlow"
                                    Click="SettingsButton_Click">
                                <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                                      Fill="{DynamicResource PrimaryTextBrush}"
                                      Width="14"
                                      Height="14"
                                      Stretch="Uniform" />
                            </Button>
                            <Button Style="{StaticResource HeaderButtonStyle}"
                                    Content="✕"
                                    Padding="8,4"
                                    ToolTip="Fechar janela (Esc)"
                                    Click="CloseButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. BARRA DE BUSCA INSTANTÂNEA -->
                <Border Grid.Row="1"
                        Background="{DynamicResource InputBgBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="12,10,12,8"
                        Padding="10,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0"
                              Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                              Fill="{DynamicResource SecondaryTextBrush}"
                              Width="14"
                              Height="14"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0" />

                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 CaretBrush="#2563EB"
                                 BorderThickness="0"
                                 FontSize="13"
                                 VerticalContentAlignment="Center" />

                        <TextBlock Grid.Column="1"
                                   Text="Buscar texto, apelido fixado ou app..."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="12.5"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding FilteredItems.Count, StringFormat={}{0} itens}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0" />
                    </Grid>
                </Border>

                <!-- 3. ABAS DE FILTRO -->
                <Border Grid.Row="2" Padding="12,0,12,8" BorderBrush="{DynamicResource DividerBorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource TabButtonStyle}"
                                     Content="Tudo"
                                     IsChecked="{Binding IsTabAll, Mode=OneWay}"
                                     Click="TabAll_Click" />
                        <RadioButton Style="{StaticResource TabButtonStyle}"
                                     IsChecked="{Binding IsTabPinned, Mode=OneWay}"
                                     Click="TabPinned_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Fixados " />
                                <TextBlock Text="{Binding PinnedCount, StringFormat=({0})}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource TabButtonStyle}"
                                     Content="Texto"
                                     IsChecked="{Binding IsTabText, Mode=OneWay}"
                                     Click="TabText_Click" />
                        <RadioButton Style="{StaticResource TabButtonStyle}"
                                     Content="Mídia"
                                     IsChecked="{Binding IsTabMedia, Mode=OneWay}"
                                     Click="TabMedia_Click" />
                    </StackPanel>
                </Border>

                <!-- 4. BARRA DE CHIPS DE TEXTO (SAUDAÇÕES / MODIFICADORES) -->
                <Border Grid.Row="3"
                        Background="{DynamicResource HeaderFooterBgBrush}"
                        BorderBrush="{DynamicResource DividerBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="10,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      platform:SmoothScrollBehavior.IsEnabled="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Chip [Nenhum] -->
                                <Button Style="{StaticResource ModifierChipButtonStyle}"
                                        Margin="0,0,6,0"
                                        Click="NoneModifierChip_Click"
                                        ToolTip="Colar sem nenhum prefixo ou sufixo adicional (Atalho: Alt+0 ou Esc)">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="8,3">
                                                <TextBlock Text="Nenhum"
                                                           Foreground="{TemplateBinding Foreground}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsNoneModifierSelected}" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#2563EB" />
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsNoneModifierSelected}" Value="False">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonBgBrush}" />
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Chips Cadastrados -->
                                <ItemsControl ItemsSource="{Binding ActiveModifiersList}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ModifierChipButtonStyle}"
                                                    Margin="0,0,6,0"
                                                    Tag="{Binding}"
                                                    Click="ModifierChip_Click"
                                                    ToolTip="{Binding TooltipText}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Padding="7,3">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Border Background="#1E3A8A"
                                                                        CornerRadius="3"
                                                                        Padding="4,1"
                                                                        Margin="0,0,5,0"
                                                                        Visibility="{Binding HasShortcut, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="{Binding ShortcutBadge}"
                                                                               Foreground="#93C5FD"
                                                                               FontSize="9.5"
                                                                               FontWeight="Bold" />
                                                                </Border>
                                                                <TextBlock Text="{Binding Label}"
                                                                           Foreground="{TemplateBinding Foreground}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#2563EB" />
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#60A5FA" />
                                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonBgBrush}" />
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Botão Rápido de Configurar Modificadores -->
                        <Button Grid.Column="1"
                                Style="{StaticResource HeaderButtonStyle}"
                                Padding="6,3"
                                Margin="4,0,0,0"
                                ToolTip="Gerenciar textos e saudações nas configurações"
                                Click="ManageModifiersButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="+" FontSize="12" FontWeight="Bold" Margin="0,0,4,0" Foreground="{DynamicResource AccentTextBrush}" />
                                <TextBlock Text="Ajustar" FontSize="10.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- 5. BARRA DE EDIÇÃO DE APELIDO / NOTA -->
                <Border Grid.Row="4"
                        Visibility="{Binding IsEditingNote, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource NoteBarBgBrush}"
                        BorderBrush="#3B82F6"
                        BorderThickness="0,0,0,1"
                        Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Apelido:"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBox x:Name="NoteEditBox"
                                 Grid.Column="1"
                                 Text="{Binding EditingNoteText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource InputBgBrush}"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 CaretBrush="#2563EB"
                                 BorderBrush="{DynamicResource InputBorderBrush}"
                                 BorderThickness="1"
                                 Padding="6,4"
                                 FontSize="12"
                                 KeyDown="NoteEditBox_KeyDown" />
                        <Button Grid.Column="2"
                                Style="{StaticResource HeaderButtonStyle}"
                                Background="#2563EB"
                                BorderBrush="#3B82F6"
                                Foreground="White"
                                Content="Salvar"
                                Margin="6,0,0,0"
                                Click="SaveNote_Click" />
                        <Button Grid.Column="3"
                                Style="{StaticResource HeaderButtonStyle}"
                                Content="Cancelar"
                                Margin="4,0,0,0"
                                Click="CancelNote_Click" />
                    </Grid>
                </Border>

                <!-- 6. LISTA DE CARTÕES DO HISTÓRICO -->
                <Grid Grid.Row="5">
                    <ListBox x:Name="ClipsListBox"
                             ItemsSource="{Binding FilteredItems}"
                             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="10,8"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.CanContentScroll="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             platform:SmoothScrollBehavior.IsEnabled="True"
                             MouseDoubleClick="ClipsListBox_MouseDoubleClick">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="UseLayoutRounding" Value="True" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="CardBorder"
                                                    Background="{DynamicResource CardBgBrush}"
                                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12,9"
                                                    Cursor="Hand">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                    <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource CardPinnedBgBrush}" />
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource CardPinnedBorderBrush}" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource CardHoverBgBrush}" />
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource CardHoverBorderBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource CardSelectedBgBrush}" />
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource CardSelectedBorderBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#F59E0B"
                                                    CornerRadius="4"
                                                    Padding="5,1"
                                                    Margin="0,0,6,0"
                                                    Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="FIXADO"
                                                           Foreground="#18181B"
                                                           FontSize="9.5"
                                                           FontWeight="Bold" />
                                            </Border>

                                            <Border Width="14"
                                                    Height="14"
                                                    CornerRadius="3"
                                                    Margin="0,0,6,0"
                                                    BorderBrush="{DynamicResource SecondaryTextBrush}"
                                                    BorderThickness="1"
                                                    Background="{Binding ColorHex}"
                                                    Visibility="{Binding IsColor, Converter={StaticResource BoolToVis}}" />

                                            <TextBlock Text="{Binding MetaSummary}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       FontSize="11.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <Button Style="{StaticResource CardActionButtonStyle}"
                                                    Content="Nota"
                                                    Margin="0,0,4,0"
                                                    ToolTip="Definir apelido/etiqueta rápida (F2)"
                                                    Tag="{Binding}"
                                                    Click="EditNoteButton_Click" />

                                            <Button Style="{StaticResource CardActionButtonStyle}"
                                                    Content="{Binding PinButtonText}"
                                                    Margin="0,0,4,0"
                                                    ToolTip="{Binding PinTooltip}"
                                                    Tag="{Binding}"
                                                    Click="PinButton_Click" />

                                            <Button Style="{StaticResource CardActionButtonStyle}"
                                                    Content="✕"
                                                    Padding="6,2"
                                                    ToolTip="Remover item do histórico (Delete)"
                                                    Tag="{Binding}"
                                                    Click="DeleteButton_Click" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Row="1"
                                            Background="#F59E0B"
                                            CornerRadius="4"
                                            Padding="7,2"
                                            Margin="0,0,0,5"
                                            HorizontalAlignment="Left"
                                            Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding TitleOrNote}"
                                                   Foreground="#111827"
                                                   FontWeight="Bold"
                                                   FontSize="11" />
                                    </Border>

                                    <TextBlock Grid.Row="2"
                                               Text="{Binding PreviewText}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="13"
                                               LineHeight="18"
                                               TextWrapping="Wrap"
                                               MaxHeight="56"
                                               TextTrimming="CharacterEllipsis" />

                                    <Border Grid.Row="3"
                                            Margin="0,6,0,0"
                                            CornerRadius="6"
                                            Background="#121215"
                                            MaxHeight="110"
                                            HorizontalAlignment="Left"
                                            Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                                        <Image Source="{Binding ImagePath}"
                                               MaxHeight="105"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Estado Vazio -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Nenhum item encontrado"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Copie qualquer texto ou imagem (Ctrl+C) para aparecer aqui."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="12"
                                   Margin="0,4,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- 7. RODAPÉ DE DICAS E STATUS -->
                <Border Grid.Row="6"
                        Background="{DynamicResource HeaderFooterBgBrush}"
                        CornerRadius="0,0,12,12"
                        BorderBrush="{DynamicResource DividerBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding StatusMessage}"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="Enter: Colar • Alt+1..9: Prefixo • Ctrl+P: Fixar • F2: Nota"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding ShowFooterHints, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
